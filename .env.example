# Backend type: remnawave or simple
BACKEND_TYPE=remnawave
BACKEND_URL=http://remnawave:3000
BACKEND_API_TOKEN=your_api_token_here

# Custom source groups
# SOURCE_{ID}_LABEL - group name shown in subscription
# SOURCE_{ID}_URL   - source URL (GitHub raw, HTTP sub, etc.)
# SOURCE_{ID}_COUNT - max servers to include from this source (0 = all)
# SOURCE_{ID}_PROBE - enable ping check (true/false)

SOURCE_1_LABEL=🇷🇺 Russia Yandex
SOURCE_1_URL=https://raw.githubusercontent.com/igareck/vpn-configs-for-russia/main/Vless-Reality-White-Lists-Rus-Mobile.txt
SOURCE_1_COUNT=10
SOURCE_1_PROBE=false

SOURCE_2_LABEL=🌍 Free World
SOURCE_2_URL=https://example.com/free-sub.txt
SOURCE_2_COUNT=5
SOURCE_2_PROBE=true

# Behaviour
REFRESH_INTERVAL=900
DEDUP_ENABLED=true
PROBE_TIMEOUT=1.5
PROBE_CONCURRENCY=12
SNAPSHOT_PATH=/data/cache.json
